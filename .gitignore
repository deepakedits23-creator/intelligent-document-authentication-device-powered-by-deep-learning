# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing and virtual environments
.pytest_cache/
venv/
env/
.env

# Node & Frontend dependencies and build artifacts
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary uploads and reports (preserve structure)
storage/uploads/*
!storage/uploads/.gitkeep
storage/reports/*
!storage/reports/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
