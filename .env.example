# DOCUMENT VERIFIER — Environment Configuration
# QUANTIX 2K26 Hackathon | Developed by Deepak & Team

# Optional custom path to Tesseract OCR executable (if installed)
# If left empty, the application automatically uses Windows.Media.Ocr native neural OCR engine!
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Application Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Document Retention: Set to True to automatically purge temporary upload files after verification
AUTO_PURGE_UPLOADS=False
